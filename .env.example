# Copy to .env and adjust. Optional variables are commented with defaults.

SECRET_KEY=change-me-please

# Database
# DB_USER=root
# DB_PASSWORD=
# DB_HOST=localhost
# DB_NAME=upkeep_db

# Flask
# FLASK_DEBUG=True
# Listen on all interfaces so phones/emulators on LAN can reach the API (default 0.0.0.0).
# FLASK_HOST=0.0.0.0
# FLASK_PORT=5000
# JSON API CORS (Expo web / tools). Default on; set false to disable.
# FLASK_ENABLE_CORS=true

# API JWT: access token lifetime in days for POST /api/v1/auth/login and /api/v1/auth/register
# Default is 7 if unset. Clamped between 1 and 365 when set.
# JWT_EXPIRATION_DAYS=7

# Technician work portfolio (optional overrides — defaults match portfolio_constants.py / mobile/src/portfolioLimits.ts)
# PORTFOLIO_MAX_ITEMS=24
# PORTFOLIO_MAX_IMAGE_BYTES=8388608
# PORTFOLIO_CAPTION_MAX_LEN=280
# PORTFOLIO_CATEGORY_MAX_LEN=60
# PORTFOLIO_MAX_VIDEOS=0
# PORTFOLIO_MAX_VIDEO_BYTES=52428800
# PORTFOLIO_MAX_VIDEO_DURATION_SEC=120
